// FinnGen regenie GWAS pipeline — Nextflow config.
// Targets Google Cloud Batch by default; a local 'standard' profile is
// included for stub runs and tiny local smoke tests.

manifest {
    name        = 'finngen-regenie-gwas'
    author      = 'FinnGen'
    description = 'Nextflow DSL2 port of the FinnGen regenie GWAS WDL pipeline (base + chip bgen + chip pgen variants).'
    mainScript  = 'main.nf'
    version     = '0.1.0'
    nextflowVersion = '>=24.10.0'
}

params {
    // --- Pipeline feature flags --------------------------------------------
    input_format           = 'bgen'           // 'bgen' or 'pgen'
    step2_resource_profile = 'dynamic'        // 'dynamic' or 'fixed'
    step2_strip_chr        = false
    gather_sort_flag       = '-k1,1g -k2,2g'
    skip_qqplot            = false
    skip_summary           = false
    skip_coding_gather     = false
    run_sex_specific       = true

    // --- Regenie / covariate knobs ----------------------------------------
    is_binary                      = true
    covariates                     = ''
    auto_remove_sex_covar          = true
    sex_col_name                   = 'SEX_IMPUTED'
    covariate_inclusion_threshold  = 10
    sex_specific_logpval           = 1.623249
    step1_bsize                    = 1000
    step1_options                  = ''
    step2_test                     = 'additive'
    step2_bsize                    = 400
    step2_options                  = '--firth --approx --pThresh 0.01 --firth-se'
    summary_pval_thresh            = 1e-6
    coding_pval_thresh             = 1e-4

    // --- Skip steps by pointing to a prior run's published outputs ---------
    step1_results       = null
    step2_results       = null

    // --- Inputs (filled in per-run via params JSON) -----------------------
    phenolist           = null
    cov_pheno           = null
    grm_bed             = null
    bgenlist            = null
    finngen_annotation  = null

    // --- Dockers (per step so they can differ as in the WDL JSON) ---------
    step1_docker          = null
    step2_docker          = null
    gather_docker         = null
    summary_docker        = null
    coding_gather_docker  = null

    // --- Outputs / infra --------------------------------------------------
    outdir          = 'results'
    gcp_project     = null
    gcp_region      = 'europe-west1'
    google_workdir  = null
}

// --- Process defaults -----------------------------------------------------
process {
    // Retry on GCP Batch spot preemption / VM recreation (50001, 50002, 50006).
    // Spot retries are also handled by google.batch.maxSpotAttempts; this is a fallback.
    errorStrategy = { (task.exitStatus == null || task.exitStatus in [50001, 50002, 50006]) ? 'retry' : 'terminate' }
    maxRetries    = 10
    // Hash inputs by path + size (ignore mtime) so GCS staging quirks don't
    // invalidate the cache across -resume runs.
    cache         = 'lenient'

    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy', enabled: false ]
}

// --- Profiles -------------------------------------------------------------
profiles {
    standard {
        process.executor = 'local'
    }

    google_batch {
        process.executor = 'google-batch'
        workDir          = params.google_workdir

        google {
            project  = params.gcp_project
            location = params.gcp_region
            batch {
                spot              = true
                maxSpotAttempts   = 1
                usePrivateAddress = true
                network           = 'global/networks/default'
                subnetwork        = 'regions/europe-west1/subnetworks/default'
		bootDiskSize      = '50 GB'
            }
        }
    }
}
